{
  "name": "warmgraph",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "WarmGraph — a warm-introduction engine for the startup funding ecosystem, built on CognoDB",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/dev.ts",
    "dev:web": "vite",
    "build": "tsc -b tsconfig.web.json && vite build",
    "preview": "vite preview",
    "seed": "tsx scripts/seed.ts",
    "seed:reset": "tsx scripts/seed.ts --reset",
    "verify": "tsx scripts/verify.ts",
    "typecheck": "tsc -b tsconfig.web.json tsconfig.server.json --force"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "dotenv": "^16.4.7",
    "neo4j-driver": "^5.28.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
