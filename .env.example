# ---------------------------------------------------------------------------
# CognoDB Cloud connection (console.cognodb.com -> your instance -> Connect)
# Copy this file to `.env` and fill in your own values. `.env` is gitignored
# and must never be committed.
# ---------------------------------------------------------------------------

# Connection URI shown when the instance is provisioned.
# Form: bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_URI=bolt+s://your-instance-id.databases.cognodb.cloud

# CognoDB always provisions the user "cognodb".
COGNODB_USER=cognodb

# The generated password. CognoDB shows this exactly once at provision time —
# if you lost it, rotate it from the console.
COGNODB_PASSWORD=your-password-here

# Optional. Leave blank to use the instance default database.
COGNODB_DATABASE=

# Optional. Port for the local API server during `npm run dev`.
PORT=3001
